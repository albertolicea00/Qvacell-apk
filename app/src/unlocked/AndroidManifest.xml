<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dashboard data pipeline (full/sideload flavor only). Silent USSD capture reuses the
         CALL_PHONE permission already declared in the shared manifest for Compras; these three
         are net-new and are gated behind the "Detección automática por SMS" toggle in Ajustes,
         off by default. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <application>
        <receiver
            android:name=".receiver.EtecsaSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.EstimationAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
